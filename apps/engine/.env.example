# PockDev engine configuration. Copy to .env and fill in the values.

# Port the HTTP server binds (Rimbra injects PORT automatically).
PORT=8080

# Rimbra PostgreSQL connection string. Required.
DATABASE_URL=postgres://user:password@host:5432/dbname

# Directory for the local payload spool and blob fallback. Optional.
DATA_DIR=.data

# Dashboard origin for CORS (apps/web on Vercel). Optional.
FRONTEND_ORIGIN=https://pockdev.vercel.app

# Bearer token the dashboard (Session 2) sends as Authorization: Bearer. Required.
API_TOKEN=change-me-long-random-token

# Rimbra S3 compatible Buckets. All four are set to enable S3 storage;
# raw bodies always spool to DATA_DIR first and mirror to the bucket.
# Leave empty to keep bodies on local disk only (dev).
S3_ENDPOINT=https://s3.rimbra.app
S3_BUCKET=pockdev-payloads
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key
S3_REGION=us-east-1

# Pocket AI Agent: any OpenAI compatible chat completions endpoint.
# Works with DeepSeek, Gemini, Groq, OpenRouter, or OpenAI.
# Leave LLM_BASE_URL empty to disable the agent (no LLM calls at all).
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=your-llm-api-key
LLM_MODEL=deepseek-chat

# GitHub REST API token used to read crashing files and open fix PRs.
# Optional but needed for reply 1 (open a fix PR).
GITHUB_TOKEN=ghp_your_token

# Rimbra messaging. RIMBRA_API_KEY is the bearer token for both APIs.
RIMBRA_API_KEY=your-rimbra-api-key
RIMBRA_WHATSAPP_URL=https://rimbra.app/api/whatsapp/send
RIMBRA_EMAIL_URL=https://rimbra.app/api/email/send

# Secret used to verify incoming WhatsApp webhooks (HMAC SHA 256 over the
# raw body, compared with the X-Rimbra-Signature header). Falls back to
# RIMBRA_API_KEY when empty.
RIMBRA_WEBHOOK_SECRET=your-webhook-secret

# Where email alerts go. Optional.
NOTIFY_EMAIL=you@example.com

# Tuning knobs (defaults shown). Optional.
FORWARDER_WORKERS=4
FORWARDER_POLL_MS=250
MAX_DELIVERY_ATTEMPTS=8
RETRY_BASE_SECONDS=5
MAX_BODY_BYTES=2097152
SPIKE_THRESHOLD=5
MUTE_MINUTES=60
